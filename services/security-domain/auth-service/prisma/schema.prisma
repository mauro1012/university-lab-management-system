generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // 1. UUID nativo en PostgreSQL
  id String @id @default(uuid()) @db.Uuid

  // 2. Credenciales
  email    String @unique
  password String

  // 3. Información del usuario
  firstName String?
  lastName  String?

  // 4. Roles del sistema universitario
  role Role @default(USER)

  // 5. Estado del usuario
  isActive Boolean @default(true)

  // 6. Auditoría
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 7. Índices
  @@index([email])

  // 8. Nombre real de la tabla
  @@map("users")
}

enum Role {
  ADMIN
  USER
  MANAGER
  STUDENT
}
